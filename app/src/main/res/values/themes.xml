<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF9800</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.VedicMantraJap</item>
    </style>

    <style name="Theme.VedicMantraJap" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/saffron_primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/saffron_primary_variant</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">@color/saffron_primary_variant</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>